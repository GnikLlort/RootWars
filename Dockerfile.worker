# RootWars worker image: durable outbox/world work + lab scan orchestration.
#
# The worker talks to a DEDICATED lab Docker daemon (LAB_DOCKER_HOST, e.g.
# tcp://lab-dind:2376 with TLS) and never mounts the host Docker socket. Only the
# docker CLI client is present here; nmap itself lives inside the lab scanner image
# that this worker launches on the lab daemon.
FROM node:22-bookworm-slim

# Pin the docker CLI from the official CLI image (client only, no daemon).
COPY --from=docker:27.3.1-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

USER 65534:65534
ENV NODE_ENV=production \
    ROLE=worker
CMD ["node", "dist/server/workers/index.js"]
