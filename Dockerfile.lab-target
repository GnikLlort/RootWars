# RootWars disposable mission target image.
#
# One container per mission/scan is started on a dedicated `--internal` Docker
# network and bound to the mission's assigned 10.240.x.y address. The service list
# is provided by the backend from the mission's RootWars-owned `lab_services_spec`.
FROM node:22-alpine

COPY scripts/lab-target.mjs /app/lab-target.mjs

USER 65534:65534
ENTRYPOINT ["node", "/app/lab-target.mjs"]
