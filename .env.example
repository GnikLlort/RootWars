# RootWars Server Configuration
# Copy to .env for local development. Production deployments MUST set real values
# for SESSION_SECRET, ALLOWED_ORIGINS, DATABASE_URL and REDIS_URL (documented below);
# the server refuses to start in production with development defaults.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Process role: 'api' (HTTP/WS only) or 'worker' (outbox/world/lab jobs) or 'all'.
# API instances never start the world/outbox loop.
ROLE=all

# Database Configuration
# With DATABASE_URL, pg.Pool connects to external PostgreSQL 16.
# Without it, RootWars uses embedded PGlite (persisted in ./.data/pgdata) for standalone dev.
DATABASE_URL=postgresql://rootwars:rootwars_dev_password@localhost:5432/rootwars
PGLITE_DATA_DIR=./.data/pgdata

# Redis Configuration (rate limits, presence, cross-instance realtime pub/sub)
# Without REDIS_URL, development falls back to the embedded ioredis-mock.
# Production REQUIRES REDIS_URL, and rate limiting fails closed when Redis is down.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_FAIL_MODE=closed

# Security & Session Settings
# SESSION_SECRET is required in production, must be >= 32 chars, and must not be a
# known development value (startup fails otherwise).
SESSION_SECRET=dev-only-session-secret-change-me-32bytes
SESSION_TTL_SECONDS=86400
# COOKIE_SECURE defaults to true when NODE_ENV=production; set it explicitly behind TLS proxies.
# COOKIE_SECURE=true

# CORS / WebSocket origin allowlist (required in production, comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Trusted proxy configuration. Leave unset (or 'false') unless a real reverse proxy
# terminates connections in front of the API; 'true' is rejected in production.
# TRUST_PROXY=127.0.0.1

# Rate limits (per minute, per client)
RATE_LIMIT_MAX_PER_MINUTE=30
COMMAND_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=30
FACTION_RATE_LIMIT_PER_MINUTE=10
WORLD_EVENT_RATE_LIMIT_PER_MINUTE=2

# Demo data is NEVER created by normal startup or by `npm run db:seed`.
# `npm run db:demo-seed` refuses to run in production and generates a one-time
# password unless DEMO_SEED_PASSWORD/--password is supplied. Do not set this in production.

# Open PvP & Protection Settings
PVP_MAX_LOSS_BPS=1000
PVP_DAILY_LOSS_CAP_BPS=2000
PVP_MIN_PROTECTED_BALANCE=500
PVP_ATTACKER_COOLDOWN_SECONDS=60
PVP_TARGET_COOLDOWN_SECONDS=120
PVP_NEW_PLAYER_SHIELD_MINUTES=60

# Isolated Lab Worker Configuration
# LAB_DOCKER_HOST must point at a DEDICATED lab Docker daemon (e.g. tcp://lab-dind:2375).
# If it is unset, lab scans fail closed with LAB_BACKEND_UNAVAILABLE and award no credit.
# LAB_ALLOW_HOST_DOCKER=true is a development-only escape hatch and is rejected in production.
LAB_DOCKER_HOST=tcp://localhost:2375
# LAB_ALLOW_HOST_DOCKER=false
LAB_NMAP_PATH=/usr/bin/nmap
LAB_NMAP_DATADIR=/usr/share/nmap
LAB_SCANNER_IMAGE=rootwars/lab-scanner:1.0.0
LAB_TARGET_IMAGE=rootwars/lab-target:1.0.0
LAB_TIMEOUT_MS=8000
LAB_MAX_OUTPUT_BYTES=65536
LAB_SCANNER_MEMORY_MB=256
LAB_SCANNER_CPUS=0.5
LAB_SCANNER_PIDS_LIMIT=32
LAB_TARGET_MEMORY_MB=128
LAB_TARGET_CPUS=0.25
LAB_TARGET_PIDS_LIMIT=64
LAB_CONTROL_TIMEOUT_MS=20000
# How long the API waits for a worker to finish a queued lab scan before reporting the failure.
LAB_SCAN_WAIT_MS=20000
