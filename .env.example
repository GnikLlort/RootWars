# RootWars Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# When DATABASE_URL is provided (e.g., via Docker Compose), pg.Pool connects to external PostgreSQL.
# When omitted or set to "pglite", RootWars uses embedded persistent PostgreSQL 16 (PGlite) in ./.data/pgdata.
DATABASE_URL=postgresql://rootwars:rootwars_dev_password@localhost:5432/rootwars
PGLITE_DATA_DIR=./.data/pgdata

# Redis Configuration
# Connects via ioredis when available; automatically falls back to embedded Redis store for standalone local dev.
REDIS_URL=redis://localhost:6379

# Security & Session Settings
SESSION_SECRET=change-me-in-production-rootwars-32-byte-secret-key
SESSION_TTL_SECONDS=86400
RATE_LIMIT_MAX_PER_MINUTE=180
COMMAND_RATE_LIMIT_PER_MINUTE=90

# Open PvP & Protection Settings
PVP_MAX_LOSS_BPS=1000
PVP_DAILY_LOSS_CAP_BPS=2000
PVP_MIN_PROTECTED_BALANCE=500
PVP_ATTACKER_COOLDOWN_SECONDS=60
PVP_TARGET_COOLDOWN_SECONDS=120
PVP_NEW_PLAYER_SHIELD_MINUTES=60

# Isolated Lab Worker Configuration
LAB_NMAP_PATH=/usr/local/bin/nmap
LAB_NMAP_DATADIR=/usr/share/nmap
LAB_SUBNET_PREFIX=10.240
LAB_TIMEOUT_MS=8000
LAB_ISOLATION_MODE=auto
