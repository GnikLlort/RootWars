{
  "name": "rootwars",
  "version": "1.0.0",
  "private": true,
  "description": "ROOTWARS - Persistent Open-World Hacking MMO with Isolated Lab Targets",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/dev-runner.ts",
    "dev:api": "tsx src/server/index.ts",
    "dev:worker": "tsx src/workers/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:demo-seed": "tsx src/db/demo-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "ioredis-mock": "^8.9.0",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
